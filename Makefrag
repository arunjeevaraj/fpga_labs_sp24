SHELL                   := $(shell which bash) -o pipefail
ABS_TOP                 := $(shell pwd)
SCRIPTS                 := $(ABS_TOP)/../scripts
VIVADO                  ?= vivado
# RTL files
RTL_SV                  += $(shell find $(ABS_TOP)/src -type f -name "*.sv")
## memory initilization files.
MIFS                    += $(shell find $(ABS_TOP)/src -type f -name "*.bin" -o -name "*.hex")
# synthesis options
VIVADO_OPTS             ?= -nolog -nojournal -mode batch 
CONSTRAINTS             += $(shell find $(ABS_TOP)/src -type f -name "*.xdc")
TOP                     ?= z1top
#simulation 
TB_TOP                  ?= $(TOP)_tb
VIVADO_SIM              := $(TOP)_sim
SIM_RTL_SV              := $(shell find $(ABS_TOP)/sim -type f -name "*.sv")
XELAB_OPTS              := -debug typical $(TB_TOP) -s $(VIVADO_SIM)

# synthesis setup
FPGA_PART               ?= xc7z020clg400-1

# @ hide the line echo.
test_print:
	@echo "Displaying the important src for the script."
	@echo "SHELL      :   $(SHELL)  "
	@echo "ABS_TOP    :   $(ABS_TOP)"
	@echo "RTL_SV     :   $(RTL_SV) "
	@echo "VIVADO_SIM :   $(VIVADO_SIM)"
	@echo "FPGA_PART  :   $(FPGA_PART) "
# lints the design files.	
lint:
	verilator --lint-only --top-module $(TOP) $(RTL_SV)

# to run the simulation. usage make sim_vivado/top_tb.sv
sim_vivado/%.sv: sim/%.sv $(RTL_SV) $(SIM_RTL_SV) build/target.tcl
	mkdir -p ./build/vivado_sim/
	cd ./build/vivado_sim/ && xvlog -sv $(RTL_SV) && xvlog -sv $(SIM_RTL_SV) && xelab $(XELAB_OPTS) && xsim -g $(VIVADO_SIM)

# to run the synthesis using vivado.
synth_vivado : build/synth/$(TOP).dcp

build/synth/$(TOP).dcp : build/target.tcl $(SCRIPTS)/synth.tcl
	mkdir -p ./build/synth/
	cd ./build/synth/ && $(VIVADO) $(VIVADO_OPTS) -source $(SCRIPTS)/synth.tcl |& tee synth.log

# to run the place and route with vivado.
impl_vivado: build/impl/$(TOP).bit

build/impl/$(TOP).bit: build/synth/$(TOP).dcp $(SCRIPTS)/impl.tcl
	mkdir -p ./build/impl/
	cd ./build/impl && $(VIVADO) $(VIVADO_OPTS) -source $(SCRIPTS)/impl.tcl |& tee impl.log


# launches vivado - and the dcp checkpoints can be used to analyse the results
vivado: build
	cd build && nohup $(VIVADO) </dev/null >/dev/null 2>&1 &	

program: build/impl/$(TOP).bit $(SCRIPTS)/program.tcl
	cd build/impl && $(VIVADO) $(VIVADO_OPTS) -source $(SCRIPTS)/program.tcl

#$@ -- points to the target
#$^ -- first prerequisitive
#$< -- all the prerequisitives
build/target.tcl: $(RTL_SV) $(CONSTRAINTS)
	mkdir -p build
	truncate -s 0 $@
	@echo "set ABS_TOP                        $(ABS_TOP)"    >> $@
	@echo "set TOP                            $(TOP)"    >> $@
	@echo "set FPGA_PART                      $(FPGA_PART)"  >> $@
	@echo "set_param general.maxThreads       4"    >> $@
	@echo "set_param general.maxBackupLogs    0"    >> $@
	@echo -n "set RTL { " >> $@
	FLIST="$(RTL_SV)"; for f in $$FLIST; do echo -n "$$f " ; done >> $@
	@echo "}" >> $@
	@echo -n "set SIM_RTL_SV { " >> $@
	FLIST="$(SIM_RTL_SV)"; for f in $$FLIST; do echo -n "$$f " ; done >> $@
	@echo "}" >> $@
	@echo -n "set CONSTRAINTS { " >> $@
	FLIST="$(CONSTRAINTS)"; for f in $$FLIST; do echo -n "$$f " ; done >> $@
	@echo "}" >> $@
	@echo -n "set MIFS { " >> $@
	FLIST="$(MIFS)"; for f in $$FLIST; do echo -n "$$f " ; done >> $@
	@echo "}" >> $@

clean:
	rm -rf ./build $(junk) *.daidir ./build/vivado_sim/output.txt \
	./build/vivado_sim/*.tb ./build/vivado_sim/*.daidir ./build/vivado_sim/csrc \
	./build/vivado_sim/ucli.key ./build/vivado_sim/*.vpd ./build/vivado_sim/*.vcd \
	./build/vivado_sim/*.tbi ./build/vivado_sim/*.fst ./build/vivado_sim/*.jou ./build/vivado_sim/*.log ./build/vivado_sim/*.out \
	./build/vivado_sim/*.pb ./build/vivado_sim/.Xil ./build/vivado_sim/*.wdb ./build/vivado_sim/xsim.dir 

